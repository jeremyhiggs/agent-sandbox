{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "scripts/**",
      "image/**",
      "tests/**",
      "*.json",
      "*.md",
      "docs/**/*.md",
      "skills/**/*.md",
      ".github/**/*.yml",
      "*.yaml",
      ".trivyignore.yaml",
      "!pnpm-lock.yaml",
      "!image/tools/*/pnpm-lock.yaml"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "markdown": { "parser": { "frontmatter": true } },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["**/*.md"],
      "linter": {
        "rules": {
          "nursery": {
            "useConsistentHeadingLevel": "error",
            "useFencedCodeLanguage": "error",
            "useSingleTopLevelHeading": "error",
            "useTopLevelHeading": "error"
          }
        }
      }
    }
  ]
}
