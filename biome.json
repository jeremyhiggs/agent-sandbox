{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts",
      "**/*.json",
      "**/*.jsonc",
      "**/*.md",
      "**/*.markdown",
      "**/*.yml",
      "**/*.yaml"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": { "noUselessCatch": "error" },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "preset": "none",
      "suspicious": { "noSelfCompare": "error" }
    }
  },
  "markdown": { "parser": { "frontmatter": true } },
  "overrides": [
    {
      "includes": ["tests/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "error",
            "noSkippedTests": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.md", "**/*.markdown"],
      "linter": {
        "rules": {
          "nursery": {
            "useConsistentHeadingLevel": "error",
            "useFencedCodeLanguage": "error",
            "useSingleTopLevelHeading": "error",
            "useTopLevelHeading": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.yml", "**/*.yaml"],
      "linter": {
        "rules": { "nursery": { "noDuplicateMapKeys": "error" } }
      }
    },
    {
      "assist": { "actions": { "source": { "useSortedKeys": "on" } } },
      "includes": ["**/*.json", "**/*.jsonc"],
      "linter": {
        "rules": { "suspicious": { "noDuplicateObjectKeys": "error" } }
      }
    },
    {
      "assist": {
        "actions": {
          "source": { "useSortedKeys": "off", "useSortedPackageJson": "on" }
        }
      },
      "includes": ["**/package.json"]
    },
    {
      "formatter": { "enabled": false },
      "includes": [".mise/locks/**/aube-lock.yaml"]
    }
  ],
  "vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true }
}
