{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "**/*.jsonc",
      "**/*.md",
      "**/*.yml",
      "**/*.yaml",
      "!.mise/**",
      "!**/pnpm-lock.yaml"
    ]
  },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": { "indentStyle": "space" },
  "markdown": { "parser": { "frontmatter": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "complexity": { "noUselessCatch": "error" },
      "suspicious": { "noSelfCompare": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["tests/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "error",
            "noSkippedTests": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.md"],
      "linter": {
        "rules": {
          "nursery": {
            "useConsistentHeadingLevel": "error",
            "useFencedCodeLanguage": "error",
            "useSingleTopLevelHeading": "error",
            "useTopLevelHeading": "error"
          }
        }
      }
    }
  ]
}
